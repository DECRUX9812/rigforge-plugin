  "steps": [
    {
      "n": 1,
      "title": "Print the frame",
      "detail": "18 printed parts, 873g PETG, 38h on a 0.4mm nozzle at 0.2mm layers. Orient load-bearing links so layer lines run along the load, not across it.",
      "tools": [
        "printer",
        "slicer"
      ],
      "min": 2291
    },
    {
      "n": 2,
      "title": "Print the skeleton in PETG",
      "detail": "873g over 38h. Thighs, shins and hip brackets take repeated shock loads — PETG, 4 walls, and print them upright so the layer lines run along the limb, not across it.",
      "tools": [
        "printer",
        "slicer"
      ],
      "min": 2291
    },
    {
      "n": 3,
      "title": "Press the hip and knee bearings",
      "detail": "Heat-set inserts, then 608 bearings into the hip and knee hubs. Bind here and the servo fights the bearing until one of them dies.",
      "tools": [
        "heat-set tip",
        "vise"
      ],
      "min": 40
    },
    {
      "n": 4,
      "title": "Build both legs as mirror pairs",
      "detail": "Assemble the left leg fully, then build the right against it as a jig — mirror-image legs that differ by 2mm walk in circles forever.",
      "tools": [
        "M3 hex key"
      ],
      "min": 60
    },
    {
      "n": 5,
      "title": "Assemble the pelvis and torso",
      "detail": "Bolt both legs to the pelvis hub, then the torso and the pack. Put the machine in a stand or hang it from a strap before it can hold itself up.",
      "tools": [
        "M3 hex key",
        "stand or strap"
      ],
      "min": 30
    },
    {
      "n": 6,
      "title": "Two buses, three rails",
      "detail": "Legs on bus 0, arms and head on bus 1, each bus on its own UBEC from its own pack. One shared rail will brown out the MCU the first time a hip stalls.",
      "tools": [
        "soldering iron",
        "multimeter"
      ],
      "min": 60
    },
    {
      "n": 7,
      "title": "Address every servo before assembly",
      "detail": "Connect one servo at a time and set its ID while it is still off the robot. Renumbering a servo inside an assembled leg is an hour of disassembly.",
      "tools": [
        "bus adapter",
        "PC"
      ],
      "min": 30
    },
    {
      "n": 8,
      "title": "First power: standing pose, low torque",
      "detail": "Run the generated stand pose with torque limits at 30%. Watch joint loads on the serial log — a joint that climbs and stays high is binding.",
      "tools": [
        "USB-C",
        "bench supply"
      ],
      "min": 25
    },
    {
      "n": 9,
      "title": "Bring up the MCU",
      "detail": "Flash the generated sketch. Open the serial monitor at 115200 and confirm you see the boot line before you send any command.",
      "tools": [
        "USB-C cable",
        "arduino-cli"
      ],
      "min": 15
    },
    {
      "n": 10,
      "title": "Load test",
      "detail": "Run the machine unloaded for 5 minutes, then measure current at the pack: typical should be ~10.6A, and no connector should be more than hand-warm.",
      "tools": [
        "multimeter / clamp meter"
      ],
      "min": 20
    },
    {
      "n": 11,
      "title": "Verify limits",
      "detail": "Walk every joint to its soft limit slowly and confirm the firmware stops it. All sizing checks passed at build time.",
      "tools": [],
      "min": 15
    }
  ]
}