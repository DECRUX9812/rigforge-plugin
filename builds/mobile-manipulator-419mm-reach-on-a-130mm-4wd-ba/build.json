  "steps": [
    {
      "n": 1,
      "title": "Print the frame",
      "detail": "21 printed parts, 1367g PETG, 60h on a 0.4mm nozzle at 0.2mm layers. Orient load-bearing links so layer lines run along the load, not across it.",
      "tools": [
        "printer",
        "slicer"
      ],
      "min": 3589
    },
    {
      "n": 2,
      "title": "Build the base",
      "detail": "Deck, rails and bulkheads first, then the four motors. Check the deck is flat to within a millimetre — the arm bolts to it, and a twisted deck becomes a leaning robot.",
      "tools": [
        "M3 hex key",
        "square"
      ],
      "min": 40
    },
    {
      "n": 3,
      "title": "Assemble the arm on the bench",
      "detail": "Arm first, base second: build the turret, shoulder, upper arm and forearm as one assembly and test it with a bench supply. Lifting a whole robot to fix a binding joint is how backs and robots both break.",
      "tools": [
        "M3 hex key",
        "bench supply"
      ],
      "min": 50
    },
    {
      "n": 4,
      "title": "Bolt the arm to the deck",
      "detail": "Four bolts through the turret flange into heat-set inserts, threadlocker on all four, then check the arm can sweep its full yaw range without the head or the pack in the way.",
      "tools": [
        "threadlocker"
      ],
      "min": 20
    },
    {
      "n": 5,
      "title": "Power and harness",
      "detail": "Split the servo rail from the drive rail: two UBECs, one per side of the deck. Route the arm bundle down through the turret centre so yaw never pulls a wire.",
      "tools": [
        "soldering iron",
        "cable ties"
      ],
      "min": 45
    },
    {
      "n": 6,
      "title": "Ballast and stability test",
      "detail": "With the arm at full extension, lift one wheel at a time and confirm the other three stay planted.",
      "tools": [],
      "min": 15
    },
    {
      "n": 7,
      "title": "Bring up the MCU",
      "detail": "Flash the generated sketch. Open the serial monitor at 115200 and confirm you see the boot line before you send any command.",
      "tools": [
        "USB-C cable",
        "arduino-cli"
      ],
      "min": 15
    },
    {
      "n": 8,
      "title": "Load test",
      "detail": "Run the machine unloaded for 5 minutes, then measure current at the pack: typical should be ~5.1A, and no connector should be more than hand-warm.",
      "tools": [
        "multimeter / clamp meter"
      ],
      "min": 20
    },
    {
      "n": 9,
      "title": "Verify limits",
      "detail": "Walk every joint to its soft limit slowly and confirm the firmware stops it. All sizing checks passed at build time.",
      "tools": [],
      "min": 15
    }
  ]
